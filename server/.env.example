# ---- server (.env.example) ----
# 服务端口
PORT=8080

# JWT 密钥（生产务必改为高强度随机值）
JWT_SECRET=change-me-to-a-long-random-secret

# token 有效期
ACCESS_TOKEN_TTL_MIN=120
REFRESH_TOKEN_TTL_HOURS=336

# CORS 允许来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据存储：配置后使用 Postgres（生产必配，重启不丢数据）；留空 = 内存 store（仅本地演示）
# DATABASE_URL=postgres://agent:pass@127.0.0.1:5432/lesson_agent?sslmode=disable

# 前端静态资源目录：配置后由 Go 单端口托管 web 构建产物（生产用 /app/web/dist）
# WEB_DIST=../web/dist

# LLM（OpenAI 架构；不配 key 则服务端进入 Demo 流式模式）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
